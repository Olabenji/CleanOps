EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_FORCE_PILOT_MODE=
EXPO_PUBLIC_WEB_APP_URL=
# From apps/mobile/app.json extra.eas.projectId after `eas init`
EXPO_PUBLIC_EAS_PROJECT_ID=0f45aaf0-43ab-47c4-9358-61ace5da1f58

EXPO_PUBLIC_SENTRY_DSN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Fleet map (web): force Lagos demo pins for AU/dev phones (true|false).
# When unset: DEV defaults ON, production builds OFF; Fleet UI toggle can override.
# VITE_FLEET_DEMO_LAGOS_PINS=true

# Required by paystack-webhook (HMAC) and resident-paystack-checkout (initialize).
# Local: supabase secrets set PAYSTACK_SECRET_KEY=sk_test_... --env local
PAYSTACK_SECRET_KEY=
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Used by resident-paystack-checkout callback_url (defaults to http://localhost:5173)
SITE_URL=http://localhost:5173

# Twilio WhatsApp (reminders, receipts, suspension notices). Business-initiated sends use
# ContentSid templates. Termii SMS is the fallback when a template SID is missing or WhatsApp fails.
# Local: npx supabase secrets set TWILIO_ACCOUNT_SID=... TWILIO_AUTH_TOKEN=... TWILIO_WHATSAPP_FROM=whatsapp:+1415... --env local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Content Template Builder SIDs (HX...). Used by dispatch-resident-comms only.
TWILIO_CONTENT_SID_PAYMENT_REMINDER=
TWILIO_CONTENT_SID_PAYMENT_RECEIPT=
TWILIO_CONTENT_SID_SUSPENSION_NOTICE=

# Shared secret for cron/machine calls to send-reminders and dispatch-resident-comms.
# Staff dashboard calls use the signed-in user JWT instead. Compared in constant time.
COMMS_CRON_SECRET=

# Termii SMS fallback when Twilio is unset, a template SID is missing, or WhatsApp delivery fails.
# Also used by phone-otp for SMS one-time codes (transactional dnd route, not promotional generic).
# TERMII_BASE_URL is optional; the code defaults to https://api.ng.termii.com.
# Local: npx supabase secrets set TERMII_API_KEY=... TERMII_SENDER_ID=CleanOps TERMII_BASE_URL=https://api.ng.termii.com --env local
TERMII_API_KEY=
TERMII_SENDER_ID=CleanOps
TERMII_BASE_URL=https://api.ng.termii.com

# Phone OTP (Edge Function phone-otp). PHONE_OTP_PEPPER is required.
# PHONE_OTP_DEV_REVEAL=true returns the OTP when Termii is unset, and only for local dev.
# The flag is ignored when SUPABASE_URL points at a hosted *.supabase.co project.
PHONE_OTP_PEPPER=
PHONE_OTP_DEV_REVEAL=
SENTRY_DSN=
