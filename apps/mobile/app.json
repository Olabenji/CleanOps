{
  "expo": {
    "name": "CleanOps",
    "slug": "cleanops",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "cleanops",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "color": "#1a7f45",
          "defaultChannel": "resident-default"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cleanops.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.cleanops.app",
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1a7f45"
      }
    },
    "extra": {
      "eas": {
        "projectId": "0f45aaf0-43ab-47c4-9358-61ace5da1f58"
      }
    },
    "owner": "olabenji"
  }
}
