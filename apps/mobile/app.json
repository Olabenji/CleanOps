{
  "expo": {
    "name": "CleanOps",
    "slug": "cleanops",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "cleanops",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "color": "#1a7f45",
          "defaultChannel": "resident-default"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow CleanOps to take stop proof photos for completed collections.",
          "photosPermission": "Allow CleanOps to attach stop proof photos from your library.",
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cleanops.app",
      "infoPlist": {
        "NSCameraUsageDescription": "CleanOps uses the camera for stop proof photos on completed collections.",
        "NSPhotoLibraryUsageDescription": "CleanOps uses your photo library for stop proof and licence uploads.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.cleanops.app",
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1a7f45"
      }
    },
    "extra": {
      "eas": {
        "projectId": "0f45aaf0-43ab-47c4-9358-61ace5da1f58"
      }
    },
    "owner": "olabenji"
  }
}
