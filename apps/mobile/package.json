{
  "name": "@cleanops/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "npx expo start",
    "start:clear": "npx expo start -c",
    "android": "npx expo start --android",
    "ios": "npx expo start --ios",
    "web": "npx expo start --web",
    "typecheck": "tsc -p tsconfig.json",
    "eas:init": "npx eas-cli init --non-interactive",
    "eas:build:android": "npx eas-cli build --profile development --platform android --non-interactive",
    "eas:build:ios": "npx eas-cli build --profile development --platform ios --non-interactive"
  },
  "dependencies": {
    "@cleanops/shared": "file:../../packages/shared",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "latest",
    "expo": "latest",
    "expo-constants": "~56.0.21",
    "expo-dev-client": "~56.0.23",
    "expo-device": "~56.0.4",
    "expo-image-picker": "~56.0.22",
    "expo-location": "~56.0.22",
    "expo-notifications": "~56.0.21",
    "expo-status-bar": "latest",
    "react": "19.2.3",
    "react-native": "latest",
    "react-native-mmkv": "latest",
    "react-native-safe-area-context": "^5.8.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-native": "^0.72.8",
    "typescript": "latest"
  }
}
