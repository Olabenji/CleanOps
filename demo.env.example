# Local demo accounts for `supabase start` / `supabase db reset`.
# Copy to `.env.demo.local` (gitignored) or run `npm run demo:passwords`,
# which creates that file with random passwords and applies them to the local
# database. Do not commit `.env.demo.local` or put these passwords in docs.
#
# Emails match supabase/seed.sql. Change an email only if you also change the seed.
# These users are not created by migrations and are not part of hosted deploy.

DEMO_OWNER_EMAIL=owner@cleanops.local
DEMO_OWNER_PASSWORD=

DEMO_DRIVER_EMAIL=driver@cleanops.local
DEMO_DRIVER_PASSWORD=

DEMO_AGENT_EMAIL=agent@cleanops.local
DEMO_AGENT_PASSWORD=

DEMO_RESIDENT_EMAIL=resident@cleanops.local
DEMO_RESIDENT_PASSWORD=

DEMO_PLATFORM_EMAIL=platform@cleanops.local
DEMO_PLATFORM_PASSWORD=

DEMO_ISLAND_EMAIL=island.owner@cleanops.local
DEMO_ISLAND_PASSWORD=
